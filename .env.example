# Ollama (local, no quota) - PRIMARY
# Defaults work for standard Ollama installation
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llava

# Google AI Studio API Key (optional fallback)
# Get yours at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (for fetching verified images)
# Get yours free at https://www.pexels.com/api/
# PEXELS_API_KEY=your_pexels_api_key_here

# PostgreSQL Database URL
# Format: postgresql+asyncpg://user:password@host:port/database
# Docker compose default:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flyrank

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Embedding Settings
EMBEDDING_DIM=768
SIMILARITY_THRESHOLD=0.65
CONFIDENCE_FLOOR=0.60
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100